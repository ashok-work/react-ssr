{
    "name": "react-redux-ssr-crud",
    "version": "1.0.0",
    "description": "SSR CRUD with React, Redux Toolkit, and Express",
    "scripts": {
        "dev": "vite",
        "build:client": "webpack --config webpack.client.js",
        "build:server": "webpack --config webpack.server.js",
        "build": "npm run build:client && npm run build:server",
        "ssr": "npm run build && node dist/server.js"
    },
    "dependencies": {
        "@reduxjs/toolkit": "^2.0.1",
        "axios": "^1.13.2",
        "express": "^4.18.2",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-redux": "^9.0.4",
        "react-router-dom": "^6.21.1"
    },
    "devDependencies": {
        "@babel/core": "^7.23.6",
        "@babel/preset-env": "^7.23.6",
        "@babel/preset-react": "^7.23.3",
        "@vitejs/plugin-react": "^5.1.0",
        "babel-loader": "^9.1.3",
        "copy-webpack-plugin": "^13.0.1",
        "vite": "^7.2.1",
        "webpack": "^5.89.0",
        "webpack-cli": "^5.1.4",
        "webpack-node-externals": "^3.0.0"
    }
}
